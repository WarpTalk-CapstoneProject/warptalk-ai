# ============================================================
# WarpTalk AI Workers — Environment Variables
# ============================================================
# Copy to .env and fill in the values.

# --- Redis ---
REDIS_URL=redis://warptalk-redis:6379
REDIS_PASSWORD=<SAME_AS_INFRASTRUCTURE_REDIS_PASSWORD>
REDIS_MAX_CONNECTIONS=10
REDIS_STREAM_MAXLEN=1000

# --- LiveKit Cloud (server-side only; never expose the secret to browsers) ---
LIVEKIT_URL=wss://<PROJECT_SUBDOMAIN>.livekit.cloud
LIVEKIT_API_KEY=<LIVEKIT_CLOUD_API_KEY>
LIVEKIT_API_SECRET=<LIVEKIT_CLOUD_API_SECRET>

# --- Worker (shared) ---
LOG_LEVEL=INFO
CHUNK_DURATION_MS=6000          # max for continuous speech; VAD flushes short turns sooner
VAD_PRE_SPEECH_MS=192
VAD_SILENCE_HANGOVER_MS=576
VAD_MIN_SPEECH_MS=288
NEAR_FIELD_GATE_ENABLED=false

# --- OpenAI SDK credential ---
# Shared fallback key for STT, Translation, Assistant, and Embedding.
# Stage-specific *_API_KEY values can override it when a worker needs its own key.
OPENAI_API_KEY=

# --- STT Worker ---
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=gpt-transcribe
STT_LANGUAGE=auto               # auto-detect or set: en, vi, zh, ja, etc.
STT_NOISE_REDUCTION=off
STT_MIN_AVG_LOGPROB=-0.7
STT_REALTIME_POOL_SIZE=4
# Measure how each utterance was said (pitch, energy, tempo, relative to the speaker's own
# normal) and attach it to the transcript segment, so the dub can be delivered the same way.
STT_PROSODY_ENABLED=true
STT_PROSODY_BASELINE_TTL_SECONDS=21600

# --- Translation Worker ---
TRANSLATION_PROVIDER=openai
TRANSLATION_API_KEY=
TRANSLATION_MODEL=gpt-5.4-nano
TRANSLATION_REALTIME_MODEL=gpt-realtime-2.1-mini
TRANSLATION_REALTIME_POOL_SIZE=4
TRANSLATION_REALTIME_TIMEOUT_SECONDS=2.0
TRANSLATION_REALTIME_MAX_OUTPUT_TOKENS=128
TRANSLATION_MAX_TOKENS=512
TRANSLATION_TEMPERATURE=0.0

# --- TTS Worker ---
TTS_PROVIDER=cartesia
TTS_API_KEY=
TTS_MODEL=sonic-turbo
TTS_SAMPLE_RATE=44100
TTS_VOICE_CLONE_MIN_SECONDS=10.0
TTS_MIN_CLONE_CHARS=8
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_SECONDS=3600
TTS_VOICE_CLONE_KEY_TTL_SECONDS=43200   # 12h — bounds Redis growth for cloned-voice cache keys
# Deliver the dub the way the speaker delivered it, from the prosody measured by the STT worker.
# Separate from STT_PROSODY_ENABLED so measuring and using can be switched independently.
TTS_PROSODY_ENABLED=true

# --- Billing Settlement Worker ---
# Only AI worker with Postgres access — settles STT/TRANSLATION/AUDIO_DUBBING usage into
# subscription.usage_records + subscription.credit_transactions (see migration 017).
BILLING_DB_DSN=postgresql://postgres:postgres@warptalk-postgres:5432/warptalk
BILLING_DB_MIN_POOL_SIZE=1
BILLING_DB_MAX_POOL_SIZE=5
BILLING_SUBSCRIPTION_CACHE_TTL_SECONDS=300

# --- AI Assistant Worker ---
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4.1
ASSISTANT_MAX_TOKENS=2048
ASSISTANT_TEMPERATURE=0.3

# --- Chat Assistant Worker (global "Ask WarpTalk" tool-calling agent) ---
ASSISTANT_CHAT_API_KEY=
ASSISTANT_CHAT_MODEL=gpt-4o-mini
ASSISTANT_CHAT_MAX_TOKENS=1024
ASSISTANT_CHAT_TEMPERATURE=0.4
ASSISTANT_CHAT_WORKSPACE_SERVICE_URL=http://workspace-service:5106
ASSISTANT_CHAT_TRANSCRIPT_SERVICE_URL=http://transcript-service:5103
ASSISTANT_CHAT_TRANSLATION_ROOM_SERVICE_URL=http://translation-room-service:5102
# Used only by get_platform_analytics, always with the caller's own bearer token.
ASSISTANT_CHAT_BILLING_SERVICE_URL=http://billing-service:5107
ASSISTANT_CHAT_AUTH_SERVICE_URL=http://auth-service:5101

# --- Embedding Worker ---
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000

# --- Vector DB ---
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_DISTANCE_METRIC=cosine
