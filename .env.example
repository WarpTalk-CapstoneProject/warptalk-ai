# ============================================================
# WarpTalk AI Workers — Environment Variables
# ============================================================
# Copy to .env and fill in the values.

# --- Redis ---
REDIS_URL=redis://warptalk-redis:6379
REDIS_PASSWORD=<SAME_AS_INFRASTRUCTURE_REDIS_PASSWORD>
REDIS_MAX_CONNECTIONS=10
REDIS_STREAM_MAXLEN=1000

# --- Worker (shared) ---
LOG_LEVEL=INFO
CHUNK_DURATION_MS=1000          # 1s chunks for sub-2s latency

# --- STT Worker ---
STT_MODEL=medium                # Whisper model: tiny/base/small/medium/large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8           # int8 for speed, float16 for accuracy
STT_LANGUAGE=auto               # auto-detect or set: en, vi, zh, ja, etc.
STT_BEAM_SIZE=1                 # 1=greedy (fast), 5=beam search (accurate)
STT_VAD_FILTER=true

# --- Translation Worker ---
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=cuda
TRANSLATION_FALLBACK_PROVIDER=google    # google or none
TRANSLATION_MAX_LENGTH=512

# --- TTS Worker ---
TTS_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cuda
TTS_EMBEDDING_MIN_SECONDS=5.0           # Seconds before first voice clone
TTS_EMBEDDING_REFINE_SECONDS=15.0       # Seconds before refined clone
TTS_DEFAULT_VOICE=en-US-AriaNeural      # Edge-TTS default voice
TTS_SAMPLE_RATE=24000

# --- AI Assistant Worker ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.3
