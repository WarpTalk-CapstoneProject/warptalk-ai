# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── STT Worker ───────────────────────────────────────────────────────
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16

# ── Translation Worker ───────────────────────────────────────────────
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=cuda

# ── TTS Worker ───────────────────────────────────────────────────────
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cuda

# ── AI Assistant Worker ──────────────────────────────────────────────
# Option 1: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Option 2: Local LLM
# LOCAL_LLM_PATH=./models/llama-3-8b.gguf

# ── General ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CHUNK_DURATION_MS=2000
